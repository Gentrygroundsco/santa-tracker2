{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "santa-tracker2",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  // Static files (the globe, textures, and the bundled app) are served for free
  // straight from Cloudflare's edge; only /api/time runs the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // `wrangler deploy` and `wrangler dev` bundle the client first.
  "build": {
    "command": "npm run build"
  }
}
